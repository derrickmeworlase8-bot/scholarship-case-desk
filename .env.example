# Copy this file to .env and fill in your real values. Never commit .env.
# (You usually won't need to do this by hand — running the app the first
# time will prompt you for a key and write it here automatically.)

# --- AI provider: set ONE of these two -------------------------------------
# Option A — FREE, no credit card: get a key at console.groq.com
GROQ_API_KEY=

# Option B — paid, generally higher quality: get a key at console.anthropic.com
ANTHROPIC_API_KEY=

# If both are set, Anthropic is used. Leave both blank and the app still
# runs fine — the Automated Pattern Scan just works without any AI review.

# --- Optional ----------------------------------------------------------------
PORT=3000
CLAUDE_MODEL=claude-sonnet-5
GROQ_MODEL=llama-3.3-70b-versatile
# Only needed if you want image/screenshot review on the free Groq tier —
# check console.groq.com/docs/models for a current vision-capable model name,
# these change more often than the text models.
GROQ_VISION_MODEL=

# Case logging (JSON file) — set to false to disable logging entirely
LOG_CASES=true

# Set this to enable the staff dashboard at /admin.html — pick a long,
# random string. Leave unset and the dashboard stays disabled.
ADMIN_KEY=
