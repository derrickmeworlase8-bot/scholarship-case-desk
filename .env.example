# Copy this file to .env and fill in your real values. Never commit .env.

# Required — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here

# Optional
PORT=3000
CLAUDE_MODEL=claude-sonnet-5

# Case logging (SQLite) — set to false to disable logging entirely
LOG_CASES=true

# Set this to enable the staff dashboard at /admin.html — pick a long,
# random string. Leave unset and the dashboard stays disabled.
ADMIN_KEY=
